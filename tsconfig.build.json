{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "paths": {
      "effect-build/Artifact": ["./packages/effect-build/src/Artifact.ts"],
      "effect-build/BuildError": ["./packages/effect-build/src/BuildError.ts"],
      "effect-build/Target": ["./packages/effect-build/src/Target.ts"],
      "effect-build/Toolchain": ["./packages/effect-build/src/Toolchain.ts"]
    },
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true
  }
}
