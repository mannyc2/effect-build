{
  "name": "@effect-build/example-cli",
  "private": true,
  "type": "module",
  "scripts": {
    "report": "node src/main.ts",
    "compile": "node src/build.ts",
    "test": "node --test test/report.test.ts",
    "test:compile": "node --test test/compile.test.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.108",
    "effect": "4.0.0-rc.112",
    "effect-build": "workspace:^",
    "effect-build-bun": "workspace:^"
  }
}
