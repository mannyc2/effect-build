{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "examples/*/src/**/*.ts",
    "examples/*/app/**/*.ts",
    "examples/*/test/**/*.ts",
    "examples/*/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
