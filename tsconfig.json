{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "test/unit/*.test.ts",
    "test/architecture/*.test.ts",
    "test/integration/*.test.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
