{
  "name": "effect-build-apple",
  "version": "0.6.1",
  "description": "Effect-native direct Developer ID distribution operations for macOS.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "effect",
    "macos",
    "codesign",
    "notarization",
    "dmg",
    "pkg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-build.git",
    "directory": "packages/effect-build-apple"
  },
  "bugs": {
    "url": "https://github.com/mannyc2/effect-build/issues"
  },
  "homepage": "https://github.com/mannyc2/effect-build#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./AppBundle": {
      "types": "./dist/AppBundle.d.ts",
      "import": "./dist/AppBundle.js"
    },
    "./Assess": {
      "types": "./dist/Assess.d.ts",
      "import": "./dist/Assess.js"
    },
    "./CodeSign": {
      "types": "./dist/CodeSign.d.ts",
      "import": "./dist/CodeSign.js"
    },
    "./DiskImage": {
      "types": "./dist/DiskImage.d.ts",
      "import": "./dist/DiskImage.js"
    },
    "./InstallerPackage": {
      "types": "./dist/InstallerPackage.d.ts",
      "import": "./dist/InstallerPackage.js"
    },
    "./Model": {
      "types": "./dist/Model.d.ts",
      "import": "./dist/Model.js"
    },
    "./Notary": {
      "types": "./dist/Notary.d.ts",
      "import": "./dist/Notary.js"
    },
    "./Staple": {
      "types": "./dist/Staple.d.ts",
      "import": "./dist/Staple.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "effect-build": "workspace:^"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta.104 <4.1.0-0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.108",
    "effect": "4.0.0-rc.112",
    "vitest": "3.2.6"
  }
}
