{
  "name": "effect-build-apple",
  "version": "0.7.0",
  "description": "macOS app bundles, signing, packaging, and notarization as composable Effect programs.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "effect",
    "macos",
    "codesign",
    "notarization",
    "dmg",
    "pkg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-build.git",
    "directory": "packages/effect-build-apple"
  },
  "bugs": {
    "url": "https://github.com/mannyc2/effect-build/issues"
  },
  "homepage": "https://github.com/mannyc2/effect-build#readme",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "effect-build": "workspace:^"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.108"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.108",
    "effect": "4.0.0-rc.108",
    "vitest": "3.2.6"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
