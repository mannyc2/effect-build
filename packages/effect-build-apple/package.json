{
  "name": "effect-build-apple",
  "version": "0.9.0",
  "description": "Run codesign, notarytool and stapler as composable Effect services.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "effect",
    "macos",
    "codesign",
    "notarization",
    "dmg",
    "pkg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-build.git",
    "directory": "packages/effect-build-apple"
  },
  "bugs": {
    "url": "https://github.com/mannyc2/effect-build/issues"
  },
  "homepage": "https://github.com/mannyc2/effect-build#readme",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Codesign": {
      "types": "./dist/Codesign.d.ts",
      "import": "./dist/Codesign.js"
    },
    "./Notarytool": {
      "types": "./dist/Notarytool.d.ts",
      "import": "./dist/Notarytool.js"
    },
    "./Stapler": {
      "types": "./dist/Stapler.d.ts",
      "import": "./dist/Stapler.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "effect-build": "workspace:^"
  },
  "peerDependencies": {
    "effect": ">=4.0.0 <4.1.0"
  },
  "devDependencies": {
    "effect": "4.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
