{
  "name": "effect-build-rolldown",
  "version": "0.7.0",
  "description": "Bundle TypeScript with Rolldown as scoped Effect programs.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "effect",
    "rolldown",
    "bundle",
    "javascript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-build.git",
    "directory": "packages/effect-build-rolldown"
  },
  "bugs": {
    "url": "https://github.com/mannyc2/effect-build/issues"
  },
  "homepage": "https://github.com/mannyc2/effect-build#readme",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "effect-build": "workspace:^",
    "rolldown": "1.2.5"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.108 <4.1.0-0"
  },
  "devDependencies": {
    "effect": "4.0.0-rc.112"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
