{
  "name": "effect-build-windows",
  "version": "0.6.1",
  "description": "Effect-native Windows artifact signing operations.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "effect",
    "windows",
    "msix",
    "authenticode",
    "signtool"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-build.git",
    "directory": "packages/effect-build-windows"
  },
  "bugs": {
    "url": "https://github.com/mannyc2/effect-build/issues"
  },
  "homepage": "https://github.com/mannyc2/effect-build#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./SignMsix": {
      "types": "./dist/SignMsix.d.ts",
      "import": "./dist/SignMsix.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "effect-build": "workspace:^"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta.104 <4.1.0-0"
  },
  "devDependencies": {
    "effect": "4.0.0-rc.112"
  }
}
