{
  "name": "effect-build-archives",
  "version": "0.7.0",
  "description": "Effect-native deterministic binary and exact Git-tree source archives.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "effect",
    "archive",
    "zip",
    "tar",
    "git"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-build.git",
    "directory": "packages/effect-build-archives"
  },
  "bugs": {
    "url": "https://github.com/mannyc2/effect-build/issues"
  },
  "homepage": "https://github.com/mannyc2/effect-build#readme",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "effect-build": "workspace:^",
    "fflate": "0.8.3"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.108 <4.1.0-0"
  },
  "devDependencies": {
    "effect": "4.0.0-rc.112"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
