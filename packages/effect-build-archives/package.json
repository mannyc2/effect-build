{
  "name": "effect-build-archives",
  "version": "0.6.1",
  "description": "Effect-native deterministic binary and exact Git-tree source archives.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "effect",
    "archive",
    "zip",
    "tar",
    "git"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-build.git",
    "directory": "packages/effect-build-archives"
  },
  "bugs": {
    "url": "https://github.com/mannyc2/effect-build/issues"
  },
  "homepage": "https://github.com/mannyc2/effect-build#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Archive": {
      "types": "./dist/Archive.d.ts",
      "import": "./dist/Archive.js"
    },
    "./ArchiveError": {
      "types": "./dist/ArchiveError.d.ts",
      "import": "./dist/ArchiveError.js"
    },
    "./Model": {
      "types": "./dist/Model.d.ts",
      "import": "./dist/Model.js"
    },
    "./SourceArchive": {
      "types": "./dist/SourceArchive.d.ts",
      "import": "./dist/SourceArchive.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "effect-build": "workspace:^"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta.104 <4.1.0-0"
  },
  "devDependencies": {
    "effect": "4.0.0-rc.108"
  }
}
