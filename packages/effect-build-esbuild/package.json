{
  "name": "effect-build-esbuild",
  "version": "0.7.0",
  "description": "Build JavaScript bundles and scoped esbuild contexts as Effect programs.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "effect",
    "esbuild",
    "bundle",
    "javascript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-build.git",
    "directory": "packages/effect-build-esbuild"
  },
  "bugs": {
    "url": "https://github.com/mannyc2/effect-build/issues"
  },
  "homepage": "https://github.com/mannyc2/effect-build#readme",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "effect-build": "workspace:^"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.108 <4.1.0-0",
    "esbuild": ">=0.28.2 <0.29.0"
  },
  "devDependencies": {
    "effect": "4.0.0-rc.112",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
