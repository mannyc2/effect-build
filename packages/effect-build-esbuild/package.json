{
  "name": "effect-build-esbuild",
  "version": "0.6.1",
  "description": "Effect-native provider API and command access for esbuild.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "effect",
    "esbuild",
    "bundle",
    "javascript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-build.git",
    "directory": "packages/effect-build-esbuild"
  },
  "bugs": {
    "url": "https://github.com/mannyc2/effect-build/issues"
  },
  "homepage": "https://github.com/mannyc2/effect-build#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Api": {
      "types": "./dist/Api/index.d.ts",
      "import": "./dist/Api/index.js"
    },
    "./Command": {
      "types": "./dist/Command/index.d.ts",
      "import": "./dist/Command/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "effect-build": "workspace:^",
    "esbuild": "0.28.2"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta.104 <4.1.0-0"
  },
  "devDependencies": {
    "effect": "4.0.0-rc.112"
  }
}
