{
  "name": "effect-build-esbuild",
  "version": "0.5.0",
  "description": "Effect-native Esbuild Build and Context operations.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "effect",
    "esbuild",
    "bundle",
    "javascript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-build.git",
    "directory": "packages/effect-build-esbuild"
  },
  "bugs": {
    "url": "https://github.com/mannyc2/effect-build/issues"
  },
  "homepage": "https://github.com/mannyc2/effect-build#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Build": {
      "types": "./dist/Build.d.ts",
      "import": "./dist/Build.js"
    },
    "./Context": {
      "types": "./dist/Context.d.ts",
      "import": "./dist/Context.js"
    },
    "./Watch": {
      "types": "./dist/Watch.d.ts",
      "import": "./dist/Watch.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "effect-build": "workspace:^",
    "esbuild": "0.28.2"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta.104 <4.1.0-0"
  },
  "devDependencies": {
    "effect": "4.0.0-rc.108"
  }
}
