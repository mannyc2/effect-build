{
  "name": "effect-build-node-sea",
  "version": "0.3.0",
  "description": "Node SEA executable provider for effect-build.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": ["effect", "node", "sea", "esbuild", "executable"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-build.git",
    "directory": "packages/effect-build-node-sea"
  },
  "bugs": { "url": "https://github.com/mannyc2/effect-build/issues" },
  "homepage": "https://github.com/mannyc2/effect-build#readme",
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": { "access": "public", "provenance": true },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "effect-build": "workspace:^",
    "esbuild": "0.28.2"
  },
  "peerDependencies": { "effect": ">=4.0.0-beta.104 <4.1.0-0" },
