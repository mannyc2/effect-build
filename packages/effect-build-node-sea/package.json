{
  "name": "effect-build-node-sea",
  "version": "0.9.0",
  "description": "Direct native Node SEA assembly as a typed Effect service.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "effect",
    "node",
    "sea",
    "executable"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-build.git",
    "directory": "packages/effect-build-node-sea"
  },
  "bugs": {
    "url": "https://github.com/mannyc2/effect-build/issues"
  },
  "homepage": "https://github.com/mannyc2/effect-build#readme",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./NodeSea": {
      "types": "./dist/NodeSea.d.ts",
      "import": "./dist/NodeSea.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "effect-build": "workspace:^"
  },
  "peerDependencies": {
    "effect": ">=4.0.0 <4.1.0"
  },
  "devDependencies": {
    "effect": "4.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
