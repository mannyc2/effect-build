{
  "name": "effect-build",
  "version": "0.9.0",
  "description": "Typed native tool bindings as composable Effect programs.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "effect",
    "bun",
    "deno",
    "compiler",
    "executable"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-build.git",
    "directory": "packages/effect-build"
  },
  "bugs": {
    "url": "https://github.com/mannyc2/effect-build/issues"
  },
  "homepage": "https://github.com/mannyc2/effect-build#readme",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Tool": {
      "types": "./dist/Tool.d.ts",
      "import": "./dist/Tool.js"
    },
    "./Atomic": {
      "types": "./dist/Atomic.d.ts",
      "import": "./dist/Atomic.js"
    },
    "./Executable": {
      "types": "./dist/Executable.d.ts",
      "import": "./dist/Executable.js"
    },
    "./Digest": {
      "types": "./dist/Digest.d.ts",
      "import": "./dist/Digest.js"
    },
    "./Environment": {
      "types": "./dist/Environment.d.ts",
      "import": "./dist/Environment.js"
    },
    "./Layout": {
      "types": "./dist/Layout.d.ts",
      "import": "./dist/Layout.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "effect": ">=4.0.0 <4.1.0"
  },
  "devDependencies": {
    "effect": "4.0.2",
    "@types/node": "24.3.0",
    "@effect/platform-node": "4.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  }
}
