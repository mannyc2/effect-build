{
  "name": "effect-build",
  "version": "0.8.0",
  "description": "Effect-native build tooling: run any tool, get a verified artifact.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "effect",
    "bun",
    "deno",
    "compiler",
    "executable"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-build.git",
    "directory": "packages/effect-build"
  },
  "bugs": {
    "url": "https://github.com/mannyc2/effect-build/issues"
  },
  "homepage": "https://github.com/mannyc2/effect-build#readme",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Artifact": {
      "types": "./dist/Artifact.d.ts",
      "import": "./dist/Artifact.js"
    },
    "./Commit": {
      "types": "./dist/Commit.d.ts",
      "import": "./dist/Commit.js"
    },
    "./Directory": {
      "types": "./dist/Directory.d.ts",
      "import": "./dist/Directory.js"
    },
    "./Executable": {
      "types": "./dist/Executable.d.ts",
      "import": "./dist/Executable.js"
    },
    "./Target": {
      "types": "./dist/Target.d.ts",
      "import": "./dist/Target.js"
    },
    "./Layout": {
      "types": "./dist/Layout.d.ts",
      "import": "./dist/Layout.js"
    },
    "./Tool": {
      "types": "./dist/Tool.d.ts",
      "import": "./dist/Tool.js"
    },
    "./Checksums": {
      "types": "./dist/Checksums.d.ts",
      "import": "./dist/Checksums.js"
    },
    "./Cache": {
      "types": "./dist/Cache.d.ts",
      "import": "./dist/Cache.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.113 <4.1.0-0",
    "@effect/platform-node": ">=4.0.0-rc.113 <4.1.0-0"
  },
  "devDependencies": {
    "effect": "4.0.0-rc.113",
    "@types/node": "24.3.0",
    "@types/semver": "7.8.0",
    "@effect/platform-node": "4.0.0-rc.113"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "semver": "7.8.5"
  },
  "peerDependenciesMeta": {
    "@effect/platform-node": {
      "optional": true
    }
  }
}
