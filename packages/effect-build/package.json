{
  "name": "effect-build",
  "version": "0.5.0",
  "description": "Effect-native build toolkit: targets, artifacts, build errors, and the external-tool kernel.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "effect",
    "bun",
    "deno",
    "compiler",
    "executable"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-build.git",
    "directory": "packages/effect-build"
  },
  "bugs": {
    "url": "https://github.com/mannyc2/effect-build/issues"
  },
  "homepage": "https://github.com/mannyc2/effect-build#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./Artifact": { "types": "./dist/Artifact.d.ts", "import": "./dist/Artifact.js" },
    "./Author/BorrowedContent": {
      "types": "./dist/Author/BorrowedContent.d.ts",
      "import": "./dist/Author/BorrowedContent.js"
    },
    "./Author/Generation": { "types": "./dist/Author/Generation.d.ts", "import": "./dist/Author/Generation.js" },
    "./Author/NodeMain": { "types": "./dist/Author/NodeMain.d.ts", "import": "./dist/Author/NodeMain.js" },
    "./Author/Tool": { "types": "./dist/Author/Tool.d.ts", "import": "./dist/Author/Tool.js" },
    "./Author/TreeSnapshot": { "types": "./dist/Author/TreeSnapshot.d.ts", "import": "./dist/Author/TreeSnapshot.js" },
    "./BuildError": { "types": "./dist/BuildError.d.ts", "import": "./dist/BuildError.js" },
    "./Profile/StaticBrowserApplication": {
      "types": "./dist/Profile/StaticBrowserApplication.d.ts",
      "import": "./dist/Profile/StaticBrowserApplication.js"
    },
    "./Target": { "types": "./dist/Target.d.ts", "import": "./dist/Target.js" }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta.104 <4.1.0-0"
  },
  "devDependencies": {
    "effect": "4.0.0-rc.108"
  }
}
