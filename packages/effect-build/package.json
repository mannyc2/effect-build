{
  "name": "effect-build",
  "version": "0.4.0",
  "description": "Effect-native build toolkit: targets, artifacts, build errors, and the external-tool kernel.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "effect",
    "bun",
    "deno",
    "compiler",
    "executable"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-build.git",
    "directory": "packages/effect-build"
  },
  "bugs": {
    "url": "https://github.com/mannyc2/effect-build/issues"
  },
  "homepage": "https://github.com/mannyc2/effect-build#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./Artifact": { "types": "./dist/Artifact.d.ts", "import": "./dist/Artifact.js" },
    "./BuildError": { "types": "./dist/BuildError.d.ts", "import": "./dist/BuildError.js" },
    "./Target": { "types": "./dist/Target.d.ts", "import": "./dist/Target.js" },
    "./Toolchain": { "types": "./dist/Toolchain.d.ts", "import": "./dist/Toolchain.js" }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta.104 <4.1.0-0"
  },
  "devDependencies": {
    "effect": "4.0.0-rc.108"
  }
}
