{
  "name": "effect-build",
  "version": "0.6.0",
  "description": "Portable Effect-native artifact, ownership, matrix, and provider-authoring contracts.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "effect",
    "bun",
    "deno",
    "compiler",
    "executable"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-build.git",
    "directory": "packages/effect-build"
  },
  "bugs": {
    "url": "https://github.com/mannyc2/effect-build/issues"
  },
  "homepage": "https://github.com/mannyc2/effect-build#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./Artifact": { "types": "./dist/Artifact.d.ts", "import": "./dist/Artifact.js" },
    "./Author/BorrowedOutput": {
      "types": "./dist/Author/BorrowedOutput.d.ts",
      "import": "./dist/Author/BorrowedOutput.js"
    },
    "./Author/Executable": { "types": "./dist/Author/Executable.d.ts", "import": "./dist/Author/Executable.js" },
    "./Author/File": { "types": "./dist/Author/File.d.ts", "import": "./dist/Author/File.js" },
    "./Author/Tool": { "types": "./dist/Author/Tool.d.ts", "import": "./dist/Author/Tool.js" },
    "./Author/Tree": { "types": "./dist/Author/Tree.d.ts", "import": "./dist/Author/Tree.js" },
    "./Matrix": { "types": "./dist/Matrix.d.ts", "import": "./dist/Matrix.js" },
    "./SystemTarget": { "types": "./dist/SystemTarget.d.ts", "import": "./dist/SystemTarget.js" }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta.104 <4.1.0-0"
  },
  "devDependencies": {
    "effect": "4.0.0-rc.108"
  }
}
