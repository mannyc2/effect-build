{
  "name": "effect-build-bun",
  "version": "0.9.0",
  "description": "Compile executables and bundle TypeScript with Bun as Effect programs.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "effect",
    "bun",
    "bundle",
    "compiler",
    "executable"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-build.git",
    "directory": "packages/effect-build-bun"
  },
  "bugs": {
    "url": "https://github.com/mannyc2/effect-build/issues"
  },
  "homepage": "https://github.com/mannyc2/effect-build#readme",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Bun": {
      "types": "./dist/Bun.d.ts",
      "import": "./dist/Bun.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "effect-build": "workspace:^"
  },
  "peerDependencies": {
    "effect": ">=4.0.0 <4.1.0"
  },
  "devDependencies": {
    "effect": "4.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
