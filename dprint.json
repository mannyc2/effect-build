{
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.95.0.wasm",
    "https://plugins.dprint.dev/json-0.20.0.wasm",
    "https://plugins.dprint.dev/markdown-0.17.0.wasm"
  ],
  "lineWidth": 120,
  "typescript": {
    "semiColons": "prefer",
    "quoteStyle": "preferDouble",
    "preferHanging": false
  },
  "includes": [
    "packages/**/*.ts",
    "packages/**/*.json",
    "test/**/*.ts",
    "examples/**/*.ts",
    "examples/**/*.json",
    "*.ts",
    "*.json",
    "tooling/**/*.json",
    "CHANGELOG.md",
    "README.md",
    "CONTRIBUTING.md",
    "AGENTS.md",
    "docs/**/*.md",
    "examples/**/*.md",
    "packages/**/*.md",
    "DESIGN.md",
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "tooling/**/*.mjs"
  ],
  "excludes": [
    "node_modules",
    "dist",
    ".bun-install-cache",
    ".agent-sources"
  ]
}
