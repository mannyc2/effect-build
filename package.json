{
  "name": "effect-build-workspace",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "examples/tool-runs",
    "examples/bun-build",
    "examples/ffmpeg-session",
    "tooling/api-docs",
    "examples/signing"
  ],
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "clean": "node scripts/clean-dist.mjs",
    "check": "bun run typecheck",
    "build": "bun run clean && tsc -b tsconfig.packages.json --force",
    "test:unit": "vitest run test/unit",
    "test:examples": "bun run --cwd examples/tool-runs test && bun run --cwd examples/bun-build test && bun run --cwd examples/ffmpeg-session test",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings --report-unused-disable-directives-severity error packages test examples vitest.config.ts scripts/check-lint-legacy.ts",
    "check:lint-legacy": "bun scripts/check-lint-legacy.ts",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "verify": "bun run build && bun run check:surface && bun run docs && bun run check && bun run lint && bun run check:lint-legacy && bun run test:release && bun run test:unit && bun run test:examples && bun run format:check",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json --noEmit",
    "test:integration:bun": "vitest run test/integration/bun.test.ts",
    "test:integration:deno": "vitest run test/integration/deno.test.ts",
    "test:integration:node-sea": "vitest run test/integration/node-sea.test.ts",
    "test:integration:nfpm": "vitest run test/integration/nfpm.test.ts",
    "test:integration:python": "vitest run test/integration/python.test.ts",
    "test:integration:sbom": "vitest run test/integration/sbom.test.ts",
    "test:integration:windows": "vitest run test/integration/windows.test.ts",
    "test:consumer": "node scripts/consumer-acceptance.mjs",
    "test:release": "node --test scripts/release-packages.test.mjs",
    "generate:surface": "node scripts/generate-public-api.mjs",
    "check:surface": "node scripts/generate-public-api.mjs --check",
    "test:integration:ffmpeg": "vitest run test/integration/ffmpeg.test.ts",
    "test:integration:tool": "vitest run test/integration/tool.test.ts",
    "docs": "bun run --cwd tooling/api-docs build",
    "test:integration:apple": "vitest run test/integration/apple.test.ts"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0",
    "@effect/platform-deno": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@effect/tsgo": "0.45.0",
    "@effect/vitest": "4.0.0",
    "@types/node": "24.3.0",
    "dprint": "0.49.1",
    "effect": "4.0.0",
    "effect-build": "workspace:*",
    "effect-build-apple": "workspace:*",
    "effect-build-bun": "workspace:*",
    "effect-build-deno": "workspace:*",
    "effect-build-nfpm": "workspace:*",
    "effect-build-node-sea": "workspace:*",
    "effect-build-python": "workspace:*",
    "effect-build-sbom": "workspace:*",
    "effect-build-windows": "workspace:*",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "typescript-api": "npm:typescript@6.0.3"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0"
  }
}
