{
  "name": "effect-build",
  "version": "0.2.0",
  "description": "Effect-native Bun and Deno executable compilation with typed failures and atomic publication.",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "license": "MIT",
  "keywords": ["effect", "bun", "deno", "compiler", "executable"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-build.git"
  },
  "bugs": {
    "url": "https://github.com/mannyc2/effect-build/issues"
  },
  "homepage": "https://github.com/mannyc2/effect-build#readme",
  "files": ["dist", "README.md", "docs", "examples"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bun": {
      "types": "./dist/Bun.d.ts",
      "import": "./dist/Bun.js"
    },
    "./deno": {
      "types": "./dist/Deno.d.ts",
      "import": "./dist/Deno.js"
    }
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm clean && tsc -b tsconfig.build.json --force",
    "prepack": "pnpm build",
    "test:types": "tstyche",
    "test:unit": "vitest run test/unit/standalone-contract.test.ts test/unit/standalone-process.test.ts test/unit/standalone-publication.test.ts test/unit/standalone-bun.test.ts test/unit/standalone-deno.test.ts test/unit/standalone-matrix.test.ts test/unit/esbuild-bundle.test.ts test/unit/node-sea.test.ts test/unit/esbuild-node-sea-pipeline.test.ts",
    "test:architecture": "vitest run test/architecture/import-boundaries.test.ts test/architecture/public-api.test.ts test/architecture/generated-and-ci.test.ts test/architecture/workflow-receipt.test.ts test/architecture/docs-contract.test.ts",
    "test:consumer": "pnpm build && node scripts/test-built-consumer.mjs",
    "test:consumer:fresh": "pnpm build && node scripts/test-built-consumer.mjs --fresh-install",
    "test:publication": "vitest run test/unit/standalone-publication.test.ts",
    "test:integration:real": "vitest run test/integration/standalone-bun.test.ts test/integration/standalone-deno.test.ts",
    "test:integration:node-sea": "vitest run test/integration/node-sea.test.ts",
    "test:integration:target": "vitest run test/integration/standalone-target-support.test.ts",
    "test:host:standalone": "vitest run test/host/standalone-node.smoke.ts",
    "test:host:extra": "bun run test/host/standalone-bun.smoke.ts && deno run --sloppy-imports --allow-run --allow-read --allow-write --allow-env test/host/standalone-deno.smoke.ts",
    "lint": "oxlint src test typetest examples",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "verify": "pnpm check && pnpm test:types && pnpm test:unit && pnpm test:consumer && pnpm test:architecture && pnpm lint && pnpm format:check",
    "verify:effect": "node scripts/verify-effect-compatibility.mjs --all",
    "verify:real": "pnpm test:integration:real && pnpm test:host:standalone",
    "verify:targets": "node scripts/verify-target-support.mjs"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta.104 <4.1.0-0"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-rc.108",
    "@effect/platform-deno": "4.0.0-rc.108",
    "@effect/platform-node": "4.0.0-rc.108",
    "@types/node": "24.3.0",
    "dprint": "0.49.1",
    "oxlint": "0.15.1",
    "tstyche": "7.2.2",
    "typescript": "6.0.3",
    "vitest": "3.2.4",
    "yaml": "2.9.0",
    "effect": "4.0.0-rc.108"
  },
  "dependencies": {
    "esbuild": "0.28.2"
  }
}
