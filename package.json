{
  "name": "effect-build-workspace",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "examples/bun",
    "examples/deno",
    "examples/esbuild",
    "examples/node-sea"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json --noEmit",
    "build": "bun run clean && tsc -b tsconfig.packages.json --force",
    "test:types": "tstyche",
    "test:unit": "vitest run test/unit/v04-artifact.test.ts test/unit/v04-primitives.test.ts test/unit/v04-esbuild-build.test.ts test/unit/v04-esbuild-context.test.ts test/unit/v04-bun-compile-executable.test.ts test/unit/v04-bun-matrix.test.ts test/unit/v04-deno-compile-executable.test.ts test/unit/v04-deno-matrix.test.ts test/unit/v04-node-sea-assemble-executable.test.ts",
    "test:architecture": "vitest run test/architecture/v04-public-cut-surface.test.ts test/architecture/v04-candidate-certification.test.ts",
    "test:consumer": "node scripts/test-built-consumer.mjs",
    "test:consumer:fresh": "node scripts/test-built-consumer.mjs --fresh-install",
    "test:publication": "vitest run test/unit/standalone-publication.test.ts",
    "test:integration:real": "vitest run test/integration/standalone-bun.test.ts test/integration/standalone-deno.test.ts",
    "test:integration:node-sea": "vitest run test/integration/node-sea.test.ts",
    "test:integration:bun-bundle": "vitest run test/integration/bun-bundle.test.ts",
    "test:integration:bun-node-sea": "vitest run test/integration/bun-node-sea.test.ts",
    "test:integration:v04-bun": "vitest run test/integration/v04-bun-compile-executable.test.ts",
    "test:integration:v04-deno": "vitest run test/integration/v04-deno-compile-executable.test.ts",
    "test:integration:v04-node-sea": "vitest run test/integration/v04-node-sea-assemble-executable.test.ts",
    "test:integration:target": "vitest run test/integration/v04-target-support.test.ts",
    "test:host:standalone": "vitest run test/host/standalone-node.smoke.ts",
    "audit:dependencies": "bun audit --audit-level=high",
    "lint": "oxlint packages test typetest examples",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "verify": "bun run build && bun run check && bun run test:types && bun run test:unit && node scripts/test-built-consumer.mjs --built && bun run test:architecture && bun run lint && bun run format:check",
    "verify:effect": "node scripts/verify-effect-compatibility.mjs --all",
    "verify:real": "bun run test:integration:real && bun run test:host:standalone",
    "verify:targets": "node scripts/verify-target-support.mjs"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-rc.108",
    "@effect/platform-deno": "4.0.0-rc.108",
    "@effect/platform-node": "4.0.0-rc.108",
    "@types/node": "24.3.0",
    "dprint": "0.49.1",
    "effect": "4.0.0-rc.108",
    "effect-build": "workspace:*",
    "effect-build-bun": "workspace:*",
    "effect-build-deno": "workspace:*",
    "effect-build-esbuild": "workspace:*",
    "effect-build-node-sea": "workspace:*",
    "esbuild": "0.28.2",
    "oxlint": "0.15.1",
    "tstyche": "7.2.2",
    "typescript": "6.0.3",
    "vitest": "3.2.6",
    "yaml": "2.9.0"
  }
}
