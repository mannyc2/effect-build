{
  "name": "effect-build-workspace",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "examples/bun",
    "examples/deno",
    "examples/esbuild",
    "examples/node-sea",
    "examples/cli",
    "examples/artifact-pipeline"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json --noEmit",
    "build": "bun run clean && tsc -b tsconfig.packages.json --force",
    "test:unit": "vitest run test/unit && bun run --cwd packages/effect-build-apple test",
    "test:examples": "bun run --cwd examples/cli test && bun run --cwd examples/esbuild test && bun run --cwd examples/artifact-pipeline test",
    "test:integration:bun": "bun scripts/run-real-bun-integration.mjs",
    "test:integration:deno": "vitest run test/integration/deno-compile-executable.test.ts test/integration/deno-bundle.test.ts",
    "test:integration:node-sea": "vitest run test/integration/node-sea-assemble-executable.test.ts",
    "test:integration:target": "vitest run test/integration/target-support.test.ts",
    "acceptance:archives": "vitest run test/integration/archives-real.test.ts",
    "acceptance:python": "vitest run test/integration/python-build-real.test.ts",
    "acceptance:nfpm:linux": "vitest run test/integration/nfpm-real.test.ts",
    "acceptance:sbom": "vitest run test/integration/sbom-real.test.ts",
    "acceptance:apple": "vitest run test/integration/apple-native-real.test.ts",
    "acceptance:windows": "vitest run test/integration/windows-msix-real.test.ts",
    "lint": "oxlint packages test examples",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "verify": "bun run build && bun run check && bun run lint && bun run test:unit && bun run test:examples"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-rc.108",
    "@effect/platform-deno": "4.0.0-rc.108",
    "@effect/platform-node": "4.0.0-rc.108",
    "@types/node": "24.3.0",
    "dprint": "0.49.1",
    "effect": "4.0.0-rc.108",
    "effect-build": "workspace:*",
    "effect-build-apple": "workspace:*",
    "effect-build-archives": "workspace:*",
    "effect-build-bun": "workspace:*",
    "effect-build-deno": "workspace:*",
    "effect-build-esbuild": "workspace:*",
    "effect-build-nfpm": "workspace:*",
    "effect-build-node-sea": "workspace:*",
    "effect-build-python": "workspace:*",
    "effect-build-rolldown": "workspace:*",
    "effect-build-sbom": "workspace:*",
    "effect-build-windows": "workspace:*",
    "esbuild": "0.28.2",
    "oxlint": "0.15.1",
    "rolldown": "1.2.5",
    "typescript": "6.0.3",
    "vitest": "3.2.6"
  }
}
